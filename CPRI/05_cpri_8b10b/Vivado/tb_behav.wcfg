<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000 ns"></ZoomStartTime>
      <ZoomEndTime time="1,027.001 ns"></ZoomEndTime>
      <Cursor1Time time="500.000 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="342"></NameColumnWidth>
      <ValueColumnWidth column_width="167"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="6" />
   <wvobject fp_name="/tb/data_in" type="array">
      <obj_property name="ElementShortName">data_in[7:0]</obj_property>
      <obj_property name="ObjectShortName">data_in[7:0]</obj_property>
   </wvobject>
   <wvobject fp_name="/tb/k_in" type="logic">
      <obj_property name="ElementShortName">k_in</obj_property>
      <obj_property name="ObjectShortName">k_in</obj_property>
   </wvobject>
   <wvobject fp_name="/tb/rd_in" type="logic">
      <obj_property name="ElementShortName">rd_in</obj_property>
      <obj_property name="ObjectShortName">rd_in</obj_property>
   </wvobject>
   <wvobject fp_name="/tb/code_out" type="array">
      <obj_property name="ElementShortName">code_out[9:0]</obj_property>
      <obj_property name="ObjectShortName">code_out[9:0]</obj_property>
      <obj_property name="Radix">BINARYRADIX</obj_property>
   </wvobject>
   <wvobject fp_name="/tb/rd_out" type="logic">
      <obj_property name="ElementShortName">rd_out</obj_property>
      <obj_property name="ObjectShortName">rd_out</obj_property>
   </wvobject>
   <wvobject fp_name="/tb/k_error" type="logic">
      <obj_property name="ElementShortName">k_error</obj_property>
      <obj_property name="ObjectShortName">k_error</obj_property>
   </wvobject>
</wave_config>
