{
	"version": "1.0",
	"modules": {
		"sfp10g_bd": {
			"proto_instances": {
				"/frame_generator_0/m_axis": {
					"interface": "xilinx.com:interface:axis:1.0",
					"ports": {
						"ACLK": { "actual": "clk"},
						"ARESET": { "actual": "rst"},
						"TDATA": { "actual": "m_axis_tdata"},
						"TKEEP": { "actual": "m_axis_tkeep"},
						"TLAST": { "actual": "m_axis_tlast"},
						"TREADY": { "actual": "m_axis_tready"},
						"TUSER": { "actual": "m_axis_tuser"},
						"TVALID": { "actual": "m_axis_tvalid"}
					}
				},
				"/xxv_ethernet_1/axis_rx_0": {
					"interface": "xilinx.com:interface:axis:1.0",
					"ports": {
						"ACLK": { "actual": "rx_core_clk_0"},
						"TDATA": { "actual": "rx_axis_tdata_0"},
						"TKEEP": { "actual": "rx_axis_tkeep_0"},
						"TLAST": { "actual": "rx_axis_tlast_0"},
						"TUSER": { "actual": "rx_axis_tuser_0"},
						"TVALID": { "actual": "rx_axis_tvalid_0"}
					}
				},
				"/xxv_ethernet_1/axis_tx_0": {
					"interface": "xilinx.com:interface:axis:1.0",
					"ports": {
						"ACLK": { "actual": "tx_clk_out_0"},
						"ARESET": { "actual": "user_tx_reset_0"},
						"TDATA": { "actual": "tx_axis_tdata_0"},
						"TKEEP": { "actual": "tx_axis_tkeep_0"},
						"TLAST": { "actual": "tx_axis_tlast_0"},
						"TREADY": { "actual": "tx_axis_tready_0"},
						"TUSER": { "actual": "tx_axis_tuser_0"},
						"TVALID": { "actual": "tx_axis_tvalid_0"}
					}
				}
			}
		}
	}
}
